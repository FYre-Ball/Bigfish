{
  "name": "bigfish",
  "version": "0.1.0",
  "description": "Bigfish — Electron desktop shell for DeepSeek Harness",
  "private": true,
  "main": "main.js",
  "author": "Bigfish",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "icons": "node make-icons.js"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.bigfish.app",
    "productName": "Bigfish",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "npmRebuild": false,
    "afterPack": "afterPack.js",
    "files": [
      "**/*",
      "!node_modules/**",
      "!dsh-bundle/**",
      "!electron-dist/**",
      "!.npm-cache/**",
      "!.electron-cache/**",
      "!.electron-builder-cache/**",
      "!.dsh-home*/**",
      "!node-runtime/**",
      "!download-electron.js",
      "!download-node.js",
      "!make-icons.js",
      "!afterPack.js",
      "!remove-pet-bg.js",
      "!update-pet-frames.js",
      "!README.md",
      "!.gitignore"
    ],
    "extraResources": [
      {
        "from": "node-runtime",
        "to": "node-runtime"
      },
      {
        "from": "dsh-bundle/node_modules",
        "to": "dsh/node_modules"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "shortcutName": "Bigfish"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    }
  }
}
